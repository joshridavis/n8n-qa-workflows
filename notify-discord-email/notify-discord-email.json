      ],
      "id": "df6d1769-cfdb-5990-8909-5bec0651785a",
      "name": "▶ Send a test alert"
    },
    {
      "parameters": {
        "jsCode": "return [{ json: {\n  subject: 'Test alert from n8n',\n  message: 'If you can read this, notifications work.',\n  html: '<p>If you can read this, <b>notifications work</b>.</p>',\n} }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        120
      ],
      "id": "2d7c1cef-1220-5853-be81-bf0c9594d1f6",
      "name": "Sample alert"
    },
    {
      "parameters": {
        "jsCode": "// ⚙️ CONFIG — the only node you need to edit.\nconst config = {\n  sendDiscord: true,\n  sendEmail: true,\n  emailFrom: 'n8n@your-company.com',\n  emailTo: 'qa-alerts@your-company.com', // several: 'a@x.com, b@x.com'\n};\n\n// Normalise whatever the caller sent.\nconst input = $input.first().json;\nconst subject = String(input.subject || 'n8n alert').slice(0, 200);\nconst message = String(input.message || '').trim();\nconst escape = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst html = String(input.html || '').trim() || `<p>${escape(message).replace(/\\n/g, '<br>')}</p>`;\n\n// Discord rejects messages over 2,000 characters.\nlet discord = `**${subject}**\\n${message}`;\nif (discord.length > 1990) discord = discord.slice(0, 1980) + '\\n…(cut)';\n\nreturn [{ json: { ...config, subject, message, html, discord } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
